### Online shop API — IntelliJ HTTP Client collection (SIS 1, Practice 7)
### Run the app with the dev profile first:  ./mvnw spring-boot:run
### Select the "dev" environment in the editor toolbar, then run requests top to bottom.
### Response ids are saved into variables (client.global.set), so later requests reuse them.
### Practice 7: requests 0a/0b log in first and save the tokens; every request that is not a public catalogue
### read sends "Authorization: Bearer {{adminToken}}". The demo users exist in the dev profile only.

############################## LOG IN (Practice 7) ##############################

### 0a. Log in as the demo admin -> 200 + accessToken (saved as adminToken)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

> {%
    client.test("200 OK with a Bearer token", () => {
        client.assert(response.status === 200);
        client.assert(response.body.tokenType === "Bearer");
    });
    client.global.set("adminToken", response.body.accessToken);
%}

### 0b. Log in as the demo customer -> 200 (saved as customerToken)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "customer",
  "password": "customer123"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200));
    client.global.set("customerToken", response.body.accessToken);
%}

############################## CATEGORIES ##############################

### 1. List all categories -> 200
GET {{baseUrl}}/categories

### 2. Create a category -> 201 + Location header
POST {{baseUrl}}/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Headphones",
  "description": "Wired and wireless headphones"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201));
    client.global.set("categoryId", response.body.id);
%}

### 3. Get category by id -> 200
GET {{baseUrl}}/categories/{{categoryId}}

### 4. Update category -> 200
PUT {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Audio",
  "description": "Headphones, speakers and microphones"
}

### 5. Duplicate category name -> 409
POST {{baseUrl}}/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "audio"
}

### 6. Invalid category (blank name) -> 400 with violations
POST {{baseUrl}}/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": " "
}

### 7. Unknown category -> 404
GET {{baseUrl}}/categories/9999

############################## PRODUCTS ##############################

### 8. Products: paging and sorting -> 200
GET {{baseUrl}}/products?page=0&size=10&sort=price,desc

### 9. Products of one category (demo category 1 = Laptops) -> 200
GET {{baseUrl}}/products?categoryId=1&sort=name

### 10. Create product -> 201
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "AUD-SONY-XM5",
  "name": "Sony WH-1000XM5",
  "description": "Noise-cancelling wireless headphones",
  "price": 159990.00,
  "stockQuantity": 4,
  "categoryId": {{categoryId}}
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201));
    client.global.set("productId", response.body.id);
%}

### 11. Get product by id -> 200
GET {{baseUrl}}/products/{{productId}}

### 12. Replace product (PUT) -> 200
PUT {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "AUD-SONY-XM5",
  "name": "Sony WH-1000XM5 (black)",
  "description": "Noise-cancelling wireless headphones, black",
  "price": 149990.00,
  "stockQuantity": 4,
  "categoryId": {{categoryId}}
}

### 13. Stock arrived (+6) -> 200
PATCH {{baseUrl}}/products/{{productId}}/stock
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "delta": 6,
  "reason": "Delivery from supplier"
}

### 14. Write-off below zero -> 409
PATCH {{baseUrl}}/products/{{productId}}/stock
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "delta": -1000,
  "reason": "Inventory check"
}

### 15. Duplicate SKU -> 409
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "AUD-SONY-XM5",
  "name": "Copy",
  "price": 1.00,
  "stockQuantity": 1,
  "categoryId": {{categoryId}}
}

### 16. Invalid product body -> 400 with a violation per field
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "bad sku",
  "name": "",
  "price": -5,
  "stockQuantity": -1
}

### 17. Category that does not exist -> 409
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "NO-CAT-1",
  "name": "Orphan",
  "price": 10.00,
  "stockQuantity": 1,
  "categoryId": 9999
}

### 18. Wrong parameter type / unknown sort field / page too large -> 400
GET {{baseUrl}}/products?categoryId=abc

###
GET {{baseUrl}}/products?sort=color

###
GET {{baseUrl}}/products?page=30000000&size=100

### 18a. size=500 is capped to 100 -> 200, "size": 100
GET {{baseUrl}}/products?size=500

### 19. Category with products cannot be deleted -> 409
DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

############################## ORDERS ##############################

### 20. Create order -> 201 (stock is reserved)
POST {{baseUrl}}/orders
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "customerName": "Nazym",
  "customerEmail": "nazym@example.com",
  "shippingAddress": "Almaty, Tole bi 59",
  "items": [
    { "productId": {{productId}}, "quantity": 2 },
    { "productId": 3, "quantity": 1 }
  ]
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201));
    client.global.set("orderId", response.body.id);
%}

### 21. Get order by id -> 200
GET {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{adminToken}}

### 22. List orders with a status filter, newest first -> 200
GET {{baseUrl}}/orders?status=NEW&page=0&size=5
Authorization: Bearer {{adminToken}}

### 23. Not enough stock -> 409
POST {{baseUrl}}/orders
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "customerName": "Aigerim",
  "customerEmail": "aigerim@example.com",
  "shippingAddress": "Astana, Mangilik El 55",
  "items": [ { "productId": {{productId}}, "quantity": 100 } ]
}

### 24. Empty order / bad email -> 400
POST {{baseUrl}}/orders
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "customerName": "Test",
  "customerEmail": "not-an-email",
  "shippingAddress": "Somewhere",
  "items": []
}

### 25. Product in an active order cannot be deleted -> 409
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}

### 26. Pay the order: NEW -> PAID -> 200
PATCH {{baseUrl}}/orders/{{orderId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "PAID" }

### 27. Illegal jump PAID -> DELIVERED -> 409
PATCH {{baseUrl}}/orders/{{orderId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "DELIVERED" }

### 28. Unknown status value -> 400
PATCH {{baseUrl}}/orders/{{orderId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "LOST" }

### 29. Active order cannot be deleted -> 409
DELETE {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{adminToken}}

### 30. Cancel order: PAID -> CANCELLED, stock goes back -> 200
PATCH {{baseUrl}}/orders/{{orderId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "CANCELLED" }

### 31. Delete cancelled order -> 204
DELETE {{baseUrl}}/orders/{{orderId}}
Authorization: Bearer {{adminToken}}

### 32. Delete product -> 204, then category -> 204
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{adminToken}}

###
DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{adminToken}}

############################## HTTP-LEVEL ERRORS ##############################

### 33. Malformed JSON -> 400
POST {{baseUrl}}/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "Broken"

### 34. Wrong Content-Type -> 415
POST {{baseUrl}}/categories
Authorization: Bearer {{adminToken}}
Content-Type: text/plain

name=Books

### 35. Method not allowed -> 405
PUT {{baseUrl}}/orders/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

### 36. Unknown endpoint -> 404 (with a token; without one, deny-by-default answers 401)
GET {{baseUrl}}/unknown
Authorization: Bearer {{adminToken}}

############################## SECURITY: 401 / 403 / 2xx (Practice 7) ##############################

### 37. Wrong password -> 401, the same generic message as for an unknown user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "wrong-password"
}

> {%
    client.test("401 Invalid username or password", () => {
        client.assert(response.status === 401);
        client.assert(response.body.message === "Invalid username or password");
    });
%}

### 38. Who am I -> 200, the user and roles read from the token
GET {{baseUrl}}/auth/me
Authorization: Bearer {{customerToken}}

### 39. Reading the catalogue needs no token -> 200
GET {{baseUrl}}/products/5

### 40. Delete a product WITHOUT a token -> 401 + WWW-Authenticate: Bearer
DELETE {{baseUrl}}/products/5

> {% client.test("401", () => client.assert(response.status === 401)); %}

### 41. Delete a product as a CUSTOMER -> 403 (signed in, but not an admin)
DELETE {{baseUrl}}/products/5
Authorization: Bearer {{customerToken}}

> {% client.test("403", () => client.assert(response.status === 403)); %}

### 42. A CUSTOMER may place an order -> 201
POST {{baseUrl}}/orders
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "customerName": "Demo Customer",
  "customerEmail": "customer@example.com",
  "shippingAddress": "Almaty, Tole bi 59",
  "items": [{ "productId": 5, "quantity": 1 }]
}

> {% client.test("201", () => client.assert(response.status === 201)); %}

### 43. ...but may not list everyone's orders -> 403
GET {{baseUrl}}/orders
Authorization: Bearer {{customerToken}}

> {% client.test("403", () => client.assert(response.status === 403)); %}

### 44. A tampered or garbage token -> 401 invalid_token
GET {{baseUrl}}/auth/me
Authorization: Bearer not-a-real-token

> {% client.test("401", () => client.assert(response.status === 401)); %}

