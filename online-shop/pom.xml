<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.example</groupId>
    <artifactId>online-shop</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>online-shop</name>
    <description>Online shop REST API — Spring Boot course project</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        Maven build profiles. The chosen Maven profile is written into application.properties
        (resource filtering with @...@), so the jar starts with the matching Spring profile.
          ./mvnw package            -> dev  (default)
          ./mvnw package -Ptest     -> test
          ./mvnw package -Pprod     -> prod (jar is named online-shop.jar)
    -->
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <app.profile>dev</app.profile>
            </properties>
        </profile>
        <profile>
            <id>test</id>
            <properties>
                <app.profile>test</app.profile>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <app.profile>prod</app.profile>
            </properties>
            <build>
                <finalName>online-shop</finalName>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
